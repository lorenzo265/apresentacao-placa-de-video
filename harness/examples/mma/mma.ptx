.version 8.7
.target sm_120
.address_size 64

// Multiplicacao de matrizes 16x8x16 em FP16 com acumulacao FP32 (HMMA)
.visible .entry mma_f16(.param .u64 pd)
{
    .reg .b32 %a<4>;
    .reg .b32 %b<2>;
    .reg .f32 %c<4>;
    .reg .f32 %d<4>;
    .reg .b64 %rd<3>;
    .reg .b32 %t;

    ld.param.u64 %rd1, [pd];
    cvta.to.global.u64 %rd2, %rd1;
    mov.u32 %t, %tid.x;
    mov.b32 %a0, %t;
    mov.b32 %a1, %t;
    mov.b32 %a2, %t;
    mov.b32 %a3, %t;
    mov.b32 %b0, %t;
    mov.b32 %b1, %t;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
        {%d0, %d1, %d2, %d3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c0, %c1, %c2, %c3};
    st.global.f32 [%rd2], %d0;
    st.global.f32 [%rd2+4], %d1;
    st.global.f32 [%rd2+8], %d2;
    st.global.f32 [%rd2+12], %d3;
    ret;
}

// Multiplicacao de matrizes 16x8x32 em FP8 (e4m3) com acumulacao FP32 (QMMA)
.visible .entry mma_fp8(.param .u64 pd)
{
    .reg .b32 %a<4>;
    .reg .b32 %b<2>;
    .reg .f32 %c<4>;
    .reg .f32 %d<4>;
    .reg .b64 %rd<3>;
    .reg .b32 %t;

    ld.param.u64 %rd1, [pd];
    cvta.to.global.u64 %rd2, %rd1;
    mov.u32 %t, %tid.x;
    mov.b32 %a0, %t;
    mov.b32 %a1, %t;
    mov.b32 %a2, %t;
    mov.b32 %a3, %t;
    mov.b32 %b0, %t;
    mov.b32 %b1, %t;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32
        {%d0, %d1, %d2, %d3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c0, %c1, %c2, %c3};
    st.global.f32 [%rd2], %d0;
    st.global.f32 [%rd2+4], %d1;
    st.global.f32 [%rd2+8], %d2;
    st.global.f32 [%rd2+12], %d3;
    ret;
}
