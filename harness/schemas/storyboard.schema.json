{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story/storyboard.json: beats, câmera e cortes",
  "type": "object",
  "required": [
    "version",
    "fps",
    "cuts",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "fps": {
      "enum": [
        24,
        30,
        60
      ]
    },
    "cuts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "max_priority"
            ],
            "additionalProperties": false,
            "properties": {
              "max_priority": {
                "enum": [
                  1,
                  2,
                  3
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "beats"
            ],
            "additionalProperties": false,
            "properties": {
              "beats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(a|t)[0-9]+\\.[0-9]+$"
                }
              }
            }
          }
        ]
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "act",
          "section",
          "level",
          "priority",
          "status",
          "hold",
          "provenance",
          "speaker"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(a|t)[0-9]+\\.[0-9]+$"
          },
          "act": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "section": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "priority": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "status": {
            "enum": [
              "ready",
              "draft",
              "blocked"
            ]
          },
          "part": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagram": {
            "type": [
              "string",
              "null"
            ]
          },
          "explode_state": {
            "type": "string",
            "pattern": "^(assembled|E[1-8])$"
          },
          "vitrine": {
            "description": "Apresentação (illustrative): a peça sai da posição da placa e fica diante da câmera do beat, com a face pedida para o público. Volta ao lugar na entrada do beat seguinte. Ver harness/plano/camera-gsap.md.",
            "type": "object",
            "additionalProperties": false,
            "required": ["peca"],
            "properties": {
              "peca": { "type": "string" },
              "face": { "enum": ["+x", "-x", "+y", "-y", "+z", "-z"] },
              "cima": { "enum": ["+x", "-x", "+y", "-y", "+z", "-z"] },
              "ocupa": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "lado": { "type": "number", "minimum": -0.5, "maximum": 0.5 },
              "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "giro": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            }
          },
          "camera": {
            "type": "object",
            "required": [
              "pos",
              "target",
              "fov",
              "duration",
              "ease"
            ],
            "additionalProperties": false,
            "properties": {
              "pos": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "target": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "fov": {
                "type": "number",
                "minimum": 10,
                "maximum": 60
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ease": {
                "type": "string"
              },
              "keys": {
                "description": "Poses intermediárias da entrada (at em fração da duração), para um beat com vários estágios de desmontagem.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["at", "pos", "target"],
                  "additionalProperties": false,
                  "properties": {
                    "at": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                    "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                    "target": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                    "fov": { "type": "number", "minimum": 10, "maximum": 60 },
                    "enquadra": { "oneOf": [ { "type": "boolean" }, { "type": "object", "additionalProperties": false, "properties": { "folga": { "type": "number", "minimum": -0.5, "maximum": 0.4 }, "pecas": { "type": "array", "items": { "type": "string" } } } } ] }
                  }
                }
              },
              "enquadra": {
                "description": "Enquadramento automático: pos e target dão só a direção; distância e alvo saem da caixa da placa no nível de explosão do instante. true ou {folga}.",
                "oneOf": [ { "type": "boolean" }, { "type": "object", "additionalProperties": false, "properties": { "folga": { "type": "number", "minimum": -0.5, "maximum": 0.4 }, "pecas": { "type": "array", "items": { "type": "string" } } } } ]
              },
              "explode_ate": {
                "description": "Fração da entrada em que a explosão termina (padrão 1).",
                "type": "number", "exclusiveMinimum": 0, "maximum": 1
              },
              "hold_orbit": {
                "description": "Graus de azimute que a câmera gira em torno do alvo depois da entrada (plano de herói).",
                "type": "number"
              }
            }
          },
          "callout": {
            "type": "object",
            "required": [
              "anchor",
              "box",
              "line_in",
              "line_out"
            ],
            "additionalProperties": false,
            "properties": {
              "anchor": {
                "type": "string",
                "description": "anchor.<...> de peça 3D, ou id de nó de diagrama"
              },
              "box": {
                "enum": [
                  "left-top",
                  "left-center",
                  "left-bottom",
                  "right-top",
                  "right-center",
                  "right-bottom"
                ]
              },
              "line_in": {
                "type": "number",
                "minimum": 0
              },
              "line_out": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "overlay": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "enum": [
                  "energy",
                  "data",
                  "heat"
                ]
              }
            }
          },
          "hold": {
            "type": "number",
            "minimum": 0,
            "description": "segundos com o texto na tela"
          },
          "provenance": {
            "type": "array",
            "items": {
              "enum": [
                "confirmed",
                "derived",
                "inferred",
                "illustrative"
              ]
            },
            "uniqueItems": true
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "view": {
            "type": "object",
            "required": [
              "diagram",
              "focus",
              "duration",
              "ease"
            ],
            "additionalProperties": false,
            "description": "enquadramento de beat de nível 2 a 4: o retângulo que envolve os nós de focus, com folga",
            "properties": {
              "diagram": {
                "type": "string",
                "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
              },
              "focus": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(tag:[a-z0-9_\\-]+|[a-z0-9_]+(\\.[a-z0-9_]+)*)$",
                  "description": "id de nó ou tag:<nome>"
                }
              },
              "padding": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ease": {
                "type": "string"
              }
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(tag:[a-z0-9_\\-]+|[a-z0-9_]+(\\.[a-z0-9_]+)*)$",
              "description": "id de nó ou tag:<nome>"
            },
            "description": "nós em destaque; os demais do diagrama ficam esmaecidos"
          },
          "flows": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
            },
            "description": "fluxos animados neste beat"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                },
                "level": {
                  "maximum": 1
                }
              }
            },
            "then": {
              "required": [
                "camera"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                },
                "level": {
                  "minimum": 2
                }
              }
            },
            "then": {
              "required": [
                "view"
              ]
            }
          }
        ]
      }
    },
    "world": {
      "type": "array",
      "description": "onde cada diagrama de topo fica no espaço único dos diagramas; diagramas embutidos (embed) não entram aqui",
      "items": {
        "type": "object",
        "required": [
          "diagram",
          "rect"
        ],
        "additionalProperties": false,
        "properties": {
          "diagram": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, largura, altura] em unidades do diagrama, y para baixo"
          }
        }
      }
    }
  }
}
