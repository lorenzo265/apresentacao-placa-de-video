{
  "name": "viewer-placa-de-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Viewer do tour: 3D da placa e diagramas SVG dos níveis 2 a 4, guiado por storyboard.json",
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "smoke": "node ../tools/smoke.cjs",
    "capture": "node ../tools/capture.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "camera-controls": "3.1.2",
    "gsap": "3.15.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "meshoptimizer": "1.3.0",
    "vite": "8.3.7"
  }
}
