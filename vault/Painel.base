filters:
  and:
    - 'tipo == "secao"'
    - 'file.inFolder("03-Roteiro")'
properties:
  ordem:
    displayName: Ordem
  nivel:
    displayName: Nível
  part_id:
    displayName: Peça (harness)
  procedencia_esperada:
    displayName: Procedência
  itens_enunciado:
    displayName: Itens do enunciado
views:
  - type: table
    name: Roteiro
    order:
      - ordem
      - file.name
      - nivel
      - status
      - procedencia_esperada
      - itens_enunciado
      - fontes
    sort:
      - property: ordem
        direction: ASC
  - type: table
    name: Para revisar
    filters:
      and:
        - 'status == "revisar"'
    order:
      - file.name
      - status
      - prazo
  - type: table
    name: Sem fonte
    filters:
      and:
        - 'fontes.isEmpty()'
    order:
      - ordem
      - file.name
      - itens_enunciado
    sort:
      - property: ordem
        direction: ASC
  - type: table
    name: Ligação com o harness
    order:
      - ordem
      - file.name
      - part_id
      - nivel
    sort:
      - property: ordem
        direction: ASC
